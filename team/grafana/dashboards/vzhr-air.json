     },
     "query": "import \"types\"\nfrom(bucket: \"default\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r.thingId =~ /^org\\.openegiz\\.zhezkazgan:agk-/ and (r._field == \"value_co_properties_value\" or r._field == \"value_no2_properties_value\" or r._field == \"value_o2_properties_value\" or r._field == \"value_co2_properties_value\" or r._field == \"value_temp_properties_value\" or r._field == \"value_velocity_properties_value\"))\n  |> filter(fn: (r) => types.isNumeric(v: r._value))\n  |> group(columns: [\"thingId\", \"_field\"])\n  |> last()\n  |> group()\n  |> pivot(rowKey: [\"thingId\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> drop(columns: [\"_start\", \"_stop\", \"_time\", \"_measurement\", \"parent\", \"originator\", \"correlationId\", \"topic\", \"host\"])",
     "refId": "A"
    }
